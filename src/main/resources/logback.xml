<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 控制台输出：简洁格式（时间+级别+消息），不使用 ANSI 颜色（Windows GBK 控制台不兼容） -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder charset="UTF-8">
            <pattern>%d{HH:mm:ss.SSS} %-5level %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 文件输出：完整格式（日期+线程+级别+来源+消息），%ex 记录完整异常堆栈供排查 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/frt.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/frt.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder charset="UTF-8">
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{30} - %msg%n%ex</pattern>
        </encoder>
    </appender>

    <!-- 根日志配置 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

    <!-- FRT 包日志配置：INFO 级别——DEBUG 细碎日志（如单文件被白名单过滤跳过）默认不显示，
         避免执行时逐文件刷屏；需要排查时再临时改 DEBUG -->
    <logger name="com.awei.frt" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <!-- 仅文件日志配置 - 不输出到控制台 -->
    <logger name="FILE_ONLY" level="DEBUG" additivity="false">
        <appender-ref ref="FILE"/>
    </logger>

    <!-- System.out 捕获：不再落文件（交互/装饰性输出只透传控制台，日志文件保持干净）。
         业务关键事件请使用 LoggerUtil.logInfo/logWarn/logError 显式记录 -->
    <logger name="System.out" level="OFF" additivity="false"/>

    <!-- System.err 捕获：错误信息必进文件 -->
    <logger name="System.err" level="ERROR" additivity="false">
        <appender-ref ref="FILE"/>
    </logger>
</configuration>
