dependency-reduced-pom.xml

# 本地专属配置（含本机路径，不入库）
/config.json

# IDE 本地配置
.idea/
.codebuddy/

# 构建产物（限定根级：src/test/resources/META-INF/services 是测试 SPI 资源，必须入库，
# 此前裸 META-INF/ 规则把它一并忽略，导致 classpathSpiStrategyIsRegistered 在干净检出上必失败）
/META-INF/

# 本地工具/运行时数据（不入库）
.dsh-meow/
.tools/
.dsh-vision-router/
diagrams/

# 多智能体协作运行时状态（不入库，规范见 .agent-teams/ 自身说明）
.agent-teams/

# 外部策略插件目录（用户自装，不入库，规范见 README）
/plugins/

# 发布产物目录（jar + 启动脚本，重新发布时重新生成）
release/
pom.xml.versionsBackup

# 用户自定义规则模板（程序运行时生成，不入库）
templates/

# 产品默认工作目录（无外部 config.json 时程序/测试按 classpath 默认创建；不入库）
/update/
/THtest/
/delete/
/backup/
